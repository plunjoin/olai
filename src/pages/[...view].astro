---
import Studio from '../components/Studio';
import type { ImageEngineMode } from '../lib/types';
import { DEFAULT_SETTINGS } from '../lib/types';
import { videoEngineForModel } from '../lib/video';
import '../styles/global.css';
import '../styles/brand.css';
const configuredImageMode = process.env.AI_IMAGE_API_MODE || import.meta.env.AI_IMAGE_API_MODE;
const imageEngineMode: ImageEngineMode | undefined = ['auto', 'native', 'upstream', 'interactions'].includes(configuredImageMode) ? configuredImageMode as ImageEngineMode : undefined;
const aiVideoModel = process.env.AI_VIDEO_MODEL || import.meta.env.AI_VIDEO_MODEL || DEFAULT_SETTINGS.videoModel;
const videoOmniAsync = (process.env.AI_VIDEO_OMNI_ASYNC || import.meta.env.AI_VIDEO_OMNI_ASYNC) === 'true';
const videoEngineMode = videoEngineForModel(aiVideoModel, videoOmniAsync);
const videoImageInput = (process.env.AI_VIDEO_IMAGE_INPUT || import.meta.env.AI_VIDEO_IMAGE_INPUT) === 'true';
const videoExtendMaxSeconds = parseInt(process.env.AI_VIDEO_EXTEND_MAX_SECONDS || import.meta.env.AI_VIDEO_EXTEND_MAX_SECONDS || '30', 10);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f8fc" />
    <meta name="description" content="Olai（Online AI Chat Companion）：你的在线 AI 伴侣与全能创意空间。温暖对话、激发灵感，支持图像、视频与音乐生成，游客本地保存，登录后跨设备查看创作记录。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Olai · Online AI Companion</title>
  </head>
  <body><Studio client:only="react" serverKey={Boolean(import.meta.env.AI_API_KEY || process.env.AI_API_KEY)} imageEngineMode={imageEngineMode} videoEngineMode={videoEngineMode} videoOmniAsync={videoOmniAsync} videoImageInput={videoImageInput} videoExtendMaxSeconds={videoExtendMaxSeconds} /><noscript>请启用 JavaScript 以使用 Olai。</noscript></body>
</html>
