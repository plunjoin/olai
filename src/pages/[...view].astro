---
import Studio from '../components/Studio';
import '../styles/global.css';
import '../styles/brand.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f8fc" />
    <meta name="description" content="Olai（Online AI Chat Companion）：你的在线 AI 伴侣与全能创意空间。温暖对话、激发灵感，支持图像、视频与音乐生成，游客本地保存，登录后跨设备查看创作记录。" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Olai · Online AI Companion</title>
  </head>
  <body><Studio client:only="react" serverKey={Boolean(import.meta.env.AI_API_KEY || process.env.AI_API_KEY)} /><noscript>请启用 JavaScript 以使用 Olai。</noscript></body>
</html>
