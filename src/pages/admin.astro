---
import AdminPanel from '../components/AdminPanel';
import { adminUser } from '../lib/server/admin';
import { refreshSettings } from '../lib/server/settings';
import { localeFromAcceptLanguage } from '../lib/i18n';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/admin.css';

export const prerender = false;

await refreshSettings(true);
const admin = await adminUser({ cookies: Astro.cookies });
// 非管理员不展示后台入口，也不返回任何后台数据；页面本身只包含一个空壳。
if (!admin) return Astro.redirect('/?admin=denied');
const locale = localeFromAcceptLanguage(Astro.request.headers.get('accept-language'));
const copy = locale === 'en'
  ? { title: 'Admin · Olai', noscript: 'Please enable JavaScript to use the admin console.' }
  : { title: '管理后台 · Olai', noscript: '请启用 JavaScript 以使用管理后台。' };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f6f8fc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{copy.title}</title>
  </head>
  <body class="adm-body">
    <AdminPanel client:load email={admin.email} />
    <noscript>{copy.noscript}</noscript>
  </body>
</html>
