---
import LoginPage from '../components/LoginPage';
import { githubEnabled } from '../lib/server/github';
import { refreshSettings } from '../lib/server/settings';
import { localeFromAcceptLanguage } from '../lib/i18n';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/auth.css';

export const prerender = false;

await refreshSettings(true);
const githubLogin = githubEnabled();
const locale = localeFromAcceptLanguage(Astro.request.headers.get('accept-language'));
const copy = locale === 'en'
  ? { title: 'Sign in · Olai', description: 'Sign in to Olai to sync your conversations, artworks and lyrics across devices.' }
  : { title: '登录 · Olai', description: '登录 Olai，同步你的会话、作品与歌词，在任何设备继续创作。' };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f6f8fc" />
    <meta name="description" content={copy.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{copy.title}</title>
  </head>
  <body>
    <LoginPage client:only="react" githubLogin={githubLogin} />
    <noscript>{locale === 'en' ? 'Please enable JavaScript to sign in to Olai.' : '请启用 JavaScript 以登录 Olai。'}</noscript>
  </body>
</html>
