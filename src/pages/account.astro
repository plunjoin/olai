---
import AccountPage from '../components/AccountPage';
import { currentUser } from '../lib/server/auth';
import { refreshSettings } from '../lib/server/settings';
import { localeFromAcceptLanguage } from '../lib/i18n';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/auth.css';

export const prerender = false;

await refreshSettings(true);
// 账号中心只对已登录用户开放；未登录时带上回跳地址去登录页。
const user = await currentUser({ cookies: Astro.cookies });
if (!user) return Astro.redirect('/login?next=%2Faccount');
const locale = localeFromAcceptLanguage(Astro.request.headers.get('accept-language'));
const copy = locale === 'en'
  ? { title: 'Account · Olai', description: 'Manage your Olai account, credits and daily allowance.' }
  : { title: '账号中心 · Olai', description: '管理你的 Olai 账号、积分与每日额度。' };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f6f8fc" />
    <meta name="description" content={copy.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{copy.title}</title>
  </head>
  <body>
    <AccountPage client:only="react" />
    <noscript>{locale === 'en' ? 'Please enable JavaScript to view your account.' : '请启用 JavaScript 以查看账号中心。'}</noscript>
  </body>
</html>
