---
import { localeFromAcceptLanguage } from '../lib/i18n';
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/download.css';

export const prerender = false;

const locale = localeFromAcceptLanguage(Astro.request.headers.get('accept-language'));
const en = locale === 'en';
const copy = en
  ? {
      title: 'Download · Olai',
      description: 'Download the Olai app when it becomes available on the App Store and Google Play. You can keep creating on the web in the meantime.',
      noscript: 'You can still use Olai in the browser while the app is being prepared for the stores.',
      eyebrow: 'GET THE APP',
      heading: 'Download Olai',
      lead: 'The iOS and Android apps are being prepared for store listing. This page is reserved for official download links after launch. You can keep using Olai on the web today.',
      ios: 'App Store',
      iosNote: 'iPhone and iPad',
      android: 'Google Play',
      androidNote: 'Android phones and tablets',
      soon: 'Coming soon',
      web: 'Use in browser',
      webNote: 'Available now, no install needed',
      webCta: 'Open Olai',
      gallery: 'Browse the gallery',
      create: 'Start creating',
      back: 'Back to home',
      foot: 'Olai · your companion for ideas',
    }
  : {
      title: '下载 · Olai',
      description: 'Olai 应用上架后，可在此下载 iOS 与 Android 版本。现在也可以继续使用网页版创作。',
      noscript: '应用上架前，你仍可直接在浏览器里使用 Olai。',
      eyebrow: 'GET THE APP',
      heading: '下载 Olai',
      lead: 'iOS 和 Android 应用正在准备上架。这个页面会留给正式发布后的下载入口。现在也可以先在网页里使用。',
      ios: 'App Store',
      iosNote: 'iPhone 和 iPad',
      android: 'Google Play',
      androidNote: 'Android 手机和平板',
      soon: '即将上架',
      web: '网页版',
      webNote: '现在就能用，无需安装',
      webCta: '打开 Olai',
      gallery: '作品广场',
      create: '开始创作',
      back: '返回首页',
      foot: 'Olai · 让灵感有个伴',
    };
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f8fc" />
    <meta name="description" content={copy.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{copy.title}</title>
  </head>
  <body class="download-body">
    <div class="download-page">
      <header class="download-top">
        <a class="download-brand" href="/" aria-label="Olai">
          <img src="/favicon.svg" width="34" height="34" alt="" />
          <span>Olai<small>Online AI Companion</small></span>
        </a>
        <nav class="download-nav">
          <a href="/">{copy.back}</a>
          <a href="/gallery">{copy.gallery}</a>
          <a href="/chat">{copy.create}</a>
        </nav>
      </header>

      <div class="page-intro download-intro">
        <div>
          <span class="eyebrow">{copy.eyebrow}</span>
          <h1>{copy.heading}</h1>
          <p>{copy.lead}</p>
        </div>
      </div>

      <section class="download-grid" aria-label={copy.heading}>
        <article class="download-card is-soon">
          <span class="download-badge">{copy.soon}</span>
          <h2>{copy.ios}</h2>
          <p>{copy.iosNote}</p>
          <span class="download-cta" aria-disabled="true">{copy.soon}</span>
        </article>
        <article class="download-card is-soon">
          <span class="download-badge">{copy.soon}</span>
          <h2>{copy.android}</h2>
          <p>{copy.androidNote}</p>
          <span class="download-cta" aria-disabled="true">{copy.soon}</span>
        </article>
        <article class="download-card is-ready">
          <h2>{copy.web}</h2>
          <p>{copy.webNote}</p>
          <a class="download-cta lime-button" href="/">{copy.webCta}</a>
        </article>
      </section>

      <footer class="page-footer">
        <span>{copy.foot}</span>
        <span>ONLINE AI COMPANION</span>
      </footer>
    </div>
    <noscript>{copy.noscript}</noscript>
  </body>
</html>
