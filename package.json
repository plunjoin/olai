{
  "name": "olai",
  "description": "Olai - Online AI Chat Companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node tooling/build.mjs",
    "build:remote": "node tooling/build.mjs --require-remote",
    "db:push": "astro db push --remote",
    "start": "node tooling/start.mjs",
    "preview": "node tooling/start.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:accounts": "node tooling/verify-accounts.mjs",
    "test:videos": "node tooling/verify-videos.mjs",
    "test:production": "node tooling/verify-production.mjs"
  },
  "dependencies": {
    "@astrojs/db": "^0.21.3",
    "@astrojs/node": "^9.4.0",
    "@astrojs/react": "^4.4.0",
    "astro": "^5.13.0",
    "dompurify": "^3.2.6",
    "dotenv": "^18.0.6",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "marked": "^16.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@libsql/client": "^0.18.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
