# 上游 OpenAI 兼容接口地址，只能由部署者配置。
AI_API_BASE_URL=https://example.com/v1
AI_API_KEY=
HOST=0.0.0.0
PORT=4321

# Optional: exact aliases for the requested engines on your gateway.
AI_CHAT_MODEL=gemini-3.5-flash
AI_IMAGE_MODEL=gemini-3.1-flash-image
# 图片生成使用 /v1/chat/completions，通过 image_size 参数控制分辨率（1K/2K/4K）。
# 请求时会自动设置足够的 max_tokens。
AI_IMAGE_API_MODE=auto
AI_VIDEO_MODEL=gemini-omni-1.1-flash
# Omni 使用 /v1/chat/completions，通过 resolution 参数和提示词控制时长、比例和画质。
# 配置为 veo-* 时使用独立 /v1/videos 任务接口，支持 4-8 秒时长，4K 需要 8 秒。
AI_MUSIC_MODEL=lyria-3.5

# 每种生成类型（图片 / 音乐 / 视频）的每日次数，0 表示禁用生成；对话不限。
# 按北京时间零点重置，修改后重启服务。
GUEST_DAILY_GENERATION_LIMIT=1
USER_DAILY_GENERATION_LIMIT=15

# 数据库配置可全部留空：npm start 自动创建 data/olai.db 并初始化表。
# 自定义本地文件示例：DATABASE_URL=data/olai.db；本地数据库无需令牌。
# 远程 Turso/libSQL 示例：DATABASE_URL=libsql://your-db.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# 兼容旧 ASTRO_DB_REMOTE_URL / ASTRO_DB_APP_TOKEN，新的 DATABASE_* 配置优先。
# npm run dev 默认使用独立的 .astro/olai-dev.db，重启不清空记录。

# 反向代理部署时填写公开站点 origin（不含路径、末尾斜杠）。
# SITE_ORIGIN=https://olai.example.com
# 仅在可信代理覆盖 X-Forwarded-For 且服务无法被直接访问时启用。
TRUST_PROXY=false
