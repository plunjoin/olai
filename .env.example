# 所有 AI_* 变量仅供服务端使用，不下发到浏览器，也不接受客户端覆盖。
# 上游 OpenAI 兼容接口地址、密钥和模型别名只能由部署者配置。
# 客户端仅获取公开服务状态；不透传 /models；系统与功能预设提示词仅在服务端组装。
AI_API_BASE_URL=https://example.com/v1
AI_API_KEY=
# 可选的服务端对话系统提示词；留空使用服务端默认值。
AI_SYSTEM_PROMPT=
HOST=0.0.0.0
PORT=4321

# Optional: exact aliases for the requested engines on your gateway.
AI_CHAT_MODEL=gemini-3.5-flash
AI_IMAGE_MODEL=gemini-3.1-flash-image
# 图片生成使用 /v1/chat/completions，通过 image_size 参数控制分辨率（1K/2K/4K）。
# 请求时会自动设置足够的 max_tokens。
AI_IMAGE_API_MODE=auto
AI_VIDEO_MODEL=gemini-omni-1.1-flash
# Omni 使用 /v1/chat/completions，通过 resolution 参数和提示词控制时长、比例和画质。
# 配置为 veo-* 时使用独立 /v1/videos 任务接口，支持 4-8 秒时长，4K 需要 8 秒。
AI_MUSIC_MODEL=lyria-3.5
AI_AUDIO_API_MODE=auto

# 短片工坊（视频工作流）为封闭内测，默认关闭。
# 关闭时：侧边栏不显示入口，访问 /workflow 或 #workflow 会回到 AI 对话，
# 短片记录接口 /api/records/workflows 返回 404。需要开放内测时设为 true。
AI_SHORT_FILM=false

# 每种生成类型（图片 / 音乐 / 视频）的每日次数，0 表示禁用生成。
# 按北京时间零点重置，修改后重启服务。
GUEST_DAILY_GENERATION_LIMIT=1
USER_DAILY_GENERATION_LIMIT=15

# 对话每日条数：游客按 IP、登录用户按账号，0 表示停用对话。
# 对话额外按 IP 限流：每分钟最多 CHAT_RATE_LIMIT 条、同时最多 CHAT_CONCURRENT_LIMIT 个
# 进行中的对话请求（含流式未结束的），0 表示不限制；超限返回 429。
GUEST_DAILY_CHAT_LIMIT=100
USER_DAILY_CHAT_LIMIT=100
CHAT_RATE_LIMIT=30
CHAT_CONCURRENT_LIMIT=20

# 数据库配置可全部留空：npm start 自动创建 data/olai.db 并初始化表。
# 自定义本地文件示例：DATABASE_URL=data/olai.db；本地数据库无需令牌。
# 远程 Turso/libSQL 示例：DATABASE_URL=libsql://your-db.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# 兼容旧 ASTRO_DB_REMOTE_URL / ASTRO_DB_APP_TOKEN，新的 DATABASE_* 配置优先。
# npm run dev 默认使用独立的 .astro/olai-dev.db，重启不清空记录。

# 反向代理部署时填写公开站点 origin（不含路径、末尾斜杠）。
# SITE_ORIGIN=https://olai.example.com
# 仅在可信代理覆盖 X-Forwarded-For 且服务无法被直接访问时启用。
TRUST_PROXY=false

# 私有阿里云 OSS（仅服务端）。开启后生成文件必须上传成功才返回本站媒体地址。
# 凭证使用最小权限 RAM 子账号；不要把真实密钥提交到 Git。
OSS_ENABLED=false
OSS_BUCKET=magicfang-linux-dev
# 必填：从 OSS 控制台读取桶实际 Region，例如 oss-cn-hangzhou（不要照抄示例猜地域）。
OSS_REGION=oss-cn-guangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS 对象前缀，不是服务器磁盘目录；对象为 opt/olai/{userid}/{time}/{uuid}-{attachmentId}.{ext}
OSS_PREFIX=opt/olai
OSS_MAX_FILE_BYTES=268435456
# 导入旧远程媒体时允许的精确 HTTPS 主机名，逗号分隔；自动包含 AI_API_BASE_URL 的主机。
# 不支持通配符、内网/本机 IP、HTTP、任意端口；重定向目标也必须在白名单内。
OSS_IMPORT_HOSTS=
# 上传/导入额度：每身份/IP每分钟请求数、每日上传字节（UTC天，默认1 GiB）。
OSS_MEDIA_RATE_LIMIT=60
OSS_MEDIA_DAILY_BYTES=1073741824
# 广场和个人库共享独立浏览额度：仅缓存未命中时扣次数和实际发送流量。
# 浏览器通过 ETag 复用，服务端缓存命中/304 均不计次数和流量。
# 服务端内存缓存最多256 MiB、单文件64 MiB、有效15分钟，仍逐次校验权限。
OSS_MEDIA_READ_RATE_LIMIT=60
OSS_MEDIA_READ_DAILY_BYTES=1073741824
